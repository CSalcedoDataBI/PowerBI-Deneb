      "calculate": "pbiFormat(datum['__dataset.2__'], (isValid(datum['__dataset.2____format']) ? datum['__dataset.2____format'] : '$ #,0'), {value: (abs(datum['__dataset.2__'])>=1e9?1e9:abs(datum['__dataset.2__'])>=1e6?1e6:abs(datum['__dataset.2__'])>=1e3?1e3:1), precision: (abs(datum['__dataset.2__'])/(abs(datum['__dataset.2__'])>=1e9?1e9:abs(datum['__dataset.2__'])>=1e6?1e6:abs(datum['__dataset.2__'])>=1e3?1e3:1) >= 100 || abs(datum['__dataset.2__'])/(abs(datum['__dataset.2__'])>=1e9?1e9:abs(datum['__dataset.2__'])>=1e6?1e6:abs(datum['__dataset.2__'])>=1e3?1e3:1) == round(abs(datum['__dataset.2__'])/(abs(datum['__dataset.2__'])>=1e9?1e9:abs(datum['__dataset.2__'])>=1e6?1e6:abs(datum['__dataset.2__'])>=1e3?1e3:1))) ? 0 : 1})",
      "as": "valueLabel"
    },
    {
      "calculate": "datum.__selected__ === 'on' ? 1 : 0",
      "as": "sel"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "sel",
          "as": "countrySel"
        }
      ],
      "groupby": [
        "__dataset.1__"
      ]
    },
    {
      "calculate": "datum['__dataset.1__'] === 'Online' || datum['__dataset.1__'] === 'United States' || datum.countrySel === 1",
      "as": "hi"
    },
    {
      "as": "hiColor",
      "calculate": "datum['__dataset.1__'] === 'Online' ? '#1F4E79' : datum['__dataset.1__'] === 'United States' ? '#E07A1F' : '#2E8B57'"
    }
  ],
