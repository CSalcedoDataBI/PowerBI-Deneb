/// Datos de muestra de la plantilla «Benchmark: ventas por país frente a Online y Estados Unidos» — tabla en línea, SIN origen
/// externo: no pide credenciales ni red, y Power BI la carga sola al abrir. Son
/// las mismas filas que la vista previa de csalcedodatabi.com/deneb/benchmark-ventas-por-pais.
/// Sustituye esta tabla por tu modelo.
table Ventas
	lineageTag: 74f5ab85-d450-c995-e302-6e84a4ad1ded

	/// Sales Amount: suma de la columna de muestra. Sustitúyela por tu medida.
	measure 'Sales Amount' = SUM(Ventas[Sales Amount valor])
		formatString: \$#,0
		lineageTag: e016c62f-7ae2-e3ae-66cc-e98b7e7b3fb9

	column 'Month Date'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 79d7a5c0-2b61-54d8-7d39-84ec8bfe1d56
		summarizeBy: none
		sourceColumn: Month Date

	column Country
		dataType: string
		lineageTag: 2a263a17-fdf2-9518-c43d-737200555a3d
		summarizeBy: none
		sourceColumn: Country

	column 'Sales Amount valor'
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: 4e261b07-26cc-8a96-2837-52dc8bb333e9
		summarizeBy: sum
		sourceColumn: Sales Amount valor

	partition Ventas = m
		mode: import
		source =
				let
					Origen = #table(
						type table [#"Month Date" = date, Country = text, #"Sales Amount valor" = number],
