        "field": "col",
        "sort": true
      },
      "range": {
        "signal": "[gridX0, gridX1]"
      }
    },
    {
      "name": "row",
      "type": "band",
      "round": true,
      "paddingInner": 0.16,
      "paddingOuter": 0.02,
      "domain": {
        "data": "kpi",
        "field": "row",
        "sort": true
      },
      "range": {
        "signal": "[gridY0, gridY1]"
      }
    },
    {
      "name": "v",
      "type": "linear",
      "zero": true,
