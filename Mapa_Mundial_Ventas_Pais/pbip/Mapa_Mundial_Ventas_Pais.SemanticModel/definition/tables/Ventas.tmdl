/// Datos de muestra de la plantilla «Mapa mundial de ventas por país» — tabla en línea, SIN origen
/// externo: no pide credenciales ni red, y Power BI la carga sola al abrir. Son
/// las mismas filas que la vista previa de csalcedodatabi.com/deneb/mapa-mundial-ventas-pais
/// (ventas SIMULADAS: inventadas para enseñar el mapa del mundo completo).
/// Sustituye esta tabla por tu modelo.
table Ventas
	lineageTag: e3127e56-a7c1-00ae-ea63-43bfffee136f

	/// Sales Amount: suma de la columna de muestra. Sustitúyela por tu medida.
	measure 'Sales Amount' = SUM(Ventas[Sales Amount valor])
		formatString: \$#,0
		lineageTag: 8eaa0f46-2262-b0b5-cd29-32d06fb61b07

	/// PY Sales Amount: suma de la columna de muestra. Sustitúyela por tu medida.
	measure 'PY Sales Amount' = SUM(Ventas[PY Sales Amount valor])
		formatString: \$#,0
		lineageTag: e7b40347-a8b8-e144-f2c2-5ad5c83d42b6

	column Country
		dataType: string
		lineageTag: c52836da-0344-b0e1-5625-15adc55d4cf0
		summarizeBy: none
		sourceColumn: Country

	column 'Sales Amount valor'
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: eadb93c0-c2e8-a0fd-240c-b3ed9df4f3c9
		summarizeBy: sum
		sourceColumn: Sales Amount valor

	column 'PY Sales Amount valor'
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: 95b1aa25-93a5-1ad0-0b9a-39cb241a073e
		summarizeBy: sum
		sourceColumn: PY Sales Amount valor

	partition Ventas = m
		mode: import
