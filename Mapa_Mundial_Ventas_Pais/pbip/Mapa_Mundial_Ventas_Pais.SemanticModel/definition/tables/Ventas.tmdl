/// Datos de muestra de la plantilla «Mapa mundial de ventas por país» — tabla en línea, SIN origen
/// externo: no pide credenciales ni red, y Power BI la carga sola al abrir. Son
/// las mismas filas que la vista previa de csalcedodatabi.com/deneb/mapa-mundial-ventas-pais
/// (ventas SIMULADAS: inventadas para enseñar el mapa del mundo completo).
/// Sustituye esta tabla por tu modelo.
table Ventas
	lineageTag: e3127e56-a7c1-00ae-ea63-43bfffee136f

	/// Sales Amount: suma de la columna de muestra. Sustitúyela por tu medida.
	measure 'Sales Amount' = SUM(Ventas[Sales Amount valor])
		formatString: \$#,0
		lineageTag: 8eaa0f46-2262-b0b5-cd29-32d06fb61b07

	/// PY Sales Amount: suma de la columna de muestra. Sustitúyela por tu medida.
	measure 'PY Sales Amount' = SUM(Ventas[PY Sales Amount valor])
		formatString: \$#,0
		lineageTag: e7b40347-a8b8-e144-f2c2-5ad5c83d42b6

	/// Closing page of a delivered PBIP (html-studio gallery: thank-you).
	measure 'HTML Thank You' =
			VAR _head = "Galería Deneb" & IF ( "Mapa Mundial Ventas Pais" <> "", IF ( "Galería Deneb" <> "", " · " ) & "Mapa Mundial Ventas Pais" )
			VAR _stamp = _head & IF ( "1.0.0" <> "", IF ( _head <> "", " · " ) & "v1.0.0" )
			RETURN
			    "<div class=""ty""> "
			        & "<div class=""ty-bar""></div> "
			        & "<aside class=""ty-side""> "
			        & "<img class=""ty-logo"" alt=""CSalcedoDataBI"" src=""data:image/svg+xml;base64,""> "
			        & "<div class=""ty-brand"">CSalcedoDataBI</div> "
			        & "<img class=""ty-photo"" alt=""Cristóbal Salcedo Beltrán"" src=""data:image/jpeg;base64,""> "
			        & "<img class=""ty-badge"" alt=""Microsoft Certified"" src=""data:image/jpeg;base64,""> "
			        & "<div class=""ty-name"">Cristóbal Salcedo Beltrán</div> "
			        & "<div class=""ty-skills"">Power BI · Fabric · Deneb</div> "
			        & "<div class=""ty-rule""></div> "
			        & "<div class=""ty-small"">Production engineer.</div> "
			        & "<div class=""ty-small"">Power BI and Deneb products · csalcedodatabi.com</div> "
			        & "<div class=""ty-site"">csalcedodatabi.com</div> "
			        & "</aside> "
			        & "<main class=""ty-main""> "
			        & "<div class=""ty-stamp"">" & SUBSTITUTE ( SUBSTITUTE ( _stamp, "&", "&amp;" ), "<", "&lt;" ) & "</div> "
			        & "<h1 class=""ty-headline"">Thanks for stopping by.</h1> "
			        & "<div class=""ty-tagline"">Templates, articles and reproducible examples for Power BI.</div> "
			        & "<div class=""ty-accent""></div> "
			        & "<a class=""ty-link primary"" href=""https://csalcedodatabi.com/""> "
			        & "<span class=""ty-glyph"">&#10022;</span> "
			        & "<span class=""ty-text""><span class=""ty-label"">Consulting services</span><span class=""ty-url"">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "https://csalcedodatabi.com/", "https://", "" ), "www.", "" ), "&", "&amp;" ) & "</span></span> "
			        & "<span class=""ty-arrow"">&#8250;</span> "
			        & "</a> "
			        & "<a class=""ty-link"" href=""https://github.com/CSalcedoDataBI/PowerBI-Deneb""> "
			        & "<span class=""ty-glyph"">&#11042;</span> "
			        & "<span class=""ty-text""><span class=""ty-label"">Files and templates</span><span class=""ty-url"">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "https://github.com/CSalcedoDataBI/PowerBI-Deneb", "https://", "" ), "www.", "" ), "&", "&amp;" ) & "</span></span> "
			        & "<span class=""ty-arrow"">&#8250;</span> "
			        & "</a> "
			        & "<a class=""ty-link"" href=""https://www.linkedin.com/build-relation/newsletter""> "
			        & "<span class=""ty-glyph"">&#9993;</span> "
			        & "<span class=""ty-text""><span class=""ty-label"">LinkedIn newsletter</span><span class=""ty-url"">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "https://www.linkedin.com/build-relation/newsletter", "https://", "" ), "www.", "" ), "&", "&amp;" ) & "</span></span> "
			        & "<span class=""ty-arrow"">&#8250;</span> "
			        & "</a> "
			        & "<a class=""ty-link"" href=""https://www.youtube.com/@CSalcedoDataBI""> "
			        & "<span class=""ty-glyph"">&#9654;</span> "
			        & "<span class=""ty-text""><span class=""ty-label"">YouTube channel</span><span class=""ty-url"">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "https://www.youtube.com/@CSalcedoDataBI", "https://", "" ), "www.", "" ), "&", "&amp;" ) & "</span></span> "
			        & "<span class=""ty-arrow"">&#8250;</span> "
			        & "</a> "
			        & "<a class=""ty-link"" href=""https://www.linkedin.com/in/cristobal-salcedo""> "
			        & "<span class=""ty-glyph"">in</span> "
			        & "<span class=""ty-text""><span class=""ty-label"">LinkedIn profile</span><span class=""ty-url"">" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "https://www.linkedin.com/in/cristobal-salcedo", "https://", "" ), "www.", "" ), "&", "&amp;" ) & "</span></span> "
			        & "<span class=""ty-arrow"">&#8250;</span> "
			        & "</a> "
			        & "<div class=""ty-author"">Author: Cristóbal Salcedo Beltrán</div> "
			        & "</main> "
			        & "</div>"
		lineageTag: 54b47977-a2d8-4aab-bb87-16981a50475f

