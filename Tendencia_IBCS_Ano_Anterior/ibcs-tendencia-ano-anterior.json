      "as": "actualLabel"
    },
    {
      "calculate": "datum.py != null ? pbiFormat(abs(datum.py), (isValid(datum['__dataset.1____format']) ? datum['__dataset.1____format'] : '$ #,0'), {value: (abs(datum.py)>=1e9?1e9:abs(datum.py)>=1e6?1e6:abs(datum.py)>=1e3?1e3:1), precision: (abs(datum.py)/(abs(datum.py)>=1e9?1e9:abs(datum.py)>=1e6?1e6:abs(datum.py)>=1e3?1e3:1) >= 100 || abs(datum.py)/(abs(datum.py)>=1e9?1e9:abs(datum.py)>=1e6?1e6:abs(datum.py)>=1e3?1e3:1) == round(abs(datum.py)/(abs(datum.py)>=1e9?1e9:abs(datum.py)>=1e6?1e6:abs(datum.py)>=1e3?1e3:1))) ? 0 : 1}) : '—'",
      "as": "pyLabel"
    },
    {
      "calculate": "datum.deltaAbs != null ? (datum.deltaAbs >= 0 ? '+' : '−') + pbiFormat(abs(datum.deltaAbs), (isValid(datum['__dataset.1____format']) ? datum['__dataset.1____format'] : '$ #,0'), {value: (abs(datum.deltaAbs)>=1e9?1e9:abs(datum.deltaAbs)>=1e6?1e6:abs(datum.deltaAbs)>=1e3?1e3:1), precision: (abs(datum.deltaAbs)/(abs(datum.deltaAbs)>=1e9?1e9:abs(datum.deltaAbs)>=1e6?1e6:abs(datum.deltaAbs)>=1e3?1e3:1) >= 100 || abs(datum.deltaAbs)/(abs(datum.deltaAbs)>=1e9?1e9:abs(datum.deltaAbs)>=1e6?1e6:abs(datum.deltaAbs)>=1e3?1e3:1) == round(abs(datum.deltaAbs)/(abs(datum.deltaAbs)>=1e9?1e9:abs(datum.deltaAbs)>=1e6?1e6:abs(datum.deltaAbs)>=1e3?1e3:1))) ? 0 : 1}) : '—'",
